# =============================================================================
# Nucleus AI Backend — Production Environment Variables
# =============================================================================

APP_NAME=Nucleus AI
APP_VERSION=1.0.0
DEBUG=false

# Database (override in docker-compose or set directly for managed DB)
DATABASE_URL=postgresql+asyncpg://nucleus:CHANGE_ME@postgres:5432/nucleus
DATABASE_URL_SYNC=postgresql+psycopg2://nucleus:CHANGE_ME@postgres:5432/nucleus

# OpenAI
OPENAI_API_KEY=sk-CHANGE_ME
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Vector DB
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nucleus_context
VECTOR_DIMENSION=1536

# CORS
CORS_ORIGINS=["https://yourdomain.com"]

# Security
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64

# Logging
LOG_LEVEL=info

# Sentry
SENTRY_DSN=
