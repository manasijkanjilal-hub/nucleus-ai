# =============================================================================
# Nucleus AI — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# See ENV_SETUP.md in the project root for detailed instructions on
# where to obtain each credential.
# =============================================================================

# ---- Application Settings ----------------------------------------------------
APP_NAME=Nucleus AI
APP_VERSION=0.1.0
# Set to false in production
DEBUG=true

# ---- PostgreSQL Database -----------------------------------------------------
# Async driver (used by SQLAlchemy async engine)
DATABASE_URL=postgresql+asyncpg://nucleus:nucleus@localhost:5432/nucleus
# Sync driver (used by Alembic migrations / seed scripts)
DATABASE_URL_SYNC=postgresql+psycopg2://nucleus:nucleus@localhost:5432/nucleus
#
# For a managed database (e.g. AWS RDS, Supabase, Neon):
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
#   DATABASE_URL_SYNC=postgresql+psycopg2://user:password@host:5432/dbname

# ---- OpenAI API --------------------------------------------------------------
# Required — powers embeddings and LLM completions
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Models (defaults shown; override to use different models)
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ---- Qdrant (Vector Database) ------------------------------------------------
# Local Qdrant (Docker): http://localhost:6333
# Qdrant Cloud: https://your-cluster.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nucleus_context
# Vector dimension must match the embedding model output
# text-embedding-3-small = 1536 dimensions
VECTOR_DIMENSION=1536

# ---- RAG / Chunking Settings -------------------------------------------------
# Controls how uploaded documents are split into chunks for vector storage
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ---- CORS (Cross-Origin Resource Sharing) ------------------------------------
# JSON array of allowed origins — must include your frontend URL
CORS_ORIGINS=["http://localhost:3000"]
#
# Multiple origins example:
# CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]
