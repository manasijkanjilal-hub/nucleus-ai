# =============================================================================
# Nucleus AI — Production Environment Variables (Docker Compose)
# =============================================================================
# Copy to .env.production and fill in real values before deploying:
#   cp .env.production.example .env.production
#
# These variables are consumed by docker-compose.prod.yml and passed to
# both the backend and frontend containers.
# See ENV_SETUP.md for detailed instructions on obtaining each credential.
# =============================================================================

# ---- Application -------------------------------------------------------------
APP_NAME=Nucleus AI
APP_ENV=production
APP_VERSION=1.0.0
DEBUG=false
# Random hex string for backend session signing (openssl rand -hex 64)
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64

# ---- Domain & URLs -----------------------------------------------------------
DOMAIN=yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_BACKEND_URL=https://yourdomain.com/api
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXTAUTH_URL=https://yourdomain.com

# ---- PostgreSQL (shared by backend + frontend) --------------------------------
POSTGRES_USER=nucleus
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=nucleus
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
#
# Constructed automatically in docker-compose; override for managed DB:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# DATABASE_URL_SYNC=postgresql+psycopg2://user:pass@host:5432/dbname

# ---- Qdrant (Vector Database) ------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=CHANGE_ME_if_using_qdrant_cloud
QDRANT_COLLECTION=nucleus_context
VECTOR_DIMENSION=1536

# ---- OpenAI / LLM ------------------------------------------------------------
OPENAI_API_KEY=sk-CHANGE_ME
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ---- RAG / Chunking ----------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ---- NextAuth (Frontend Authentication) --------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# ---- Frontend Database (Prisma) — uses same Postgres -------------------------
# Note: Prisma needs the standard postgres:// scheme (not asyncpg)
# DATABASE_URL=postgresql://nucleus:CHANGE_ME@postgres:5432/nucleus

# ---- CORS --------------------------------------------------------------------
CORS_ORIGINS=["https://yourdomain.com"]

# ---- Rate Limiting -----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# ---- Logging -----------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Sentry (Error Tracking — optional) --------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- AWS S3 (File Uploads — optional) ----------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=nucleus-ai/uploads

# ---- Email / SMTP (optional) -------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
