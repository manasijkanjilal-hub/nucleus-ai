# =============================================================================
# Nucleus AI — Production Environment Variables
# Copy to .env.production and fill in real values
# =============================================================================

# ---- Application -------------------------------------------------------------
APP_NAME=Nucleus AI
APP_ENV=production
DEBUG=false
APP_VERSION=1.0.0
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64

# ---- Domain ------------------------------------------------------------------
DOMAIN=yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXTAUTH_URL=https://yourdomain.com

# ---- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=nucleus
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=nucleus
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Constructed automatically in docker-compose.prod.yml; override if using managed DB:
# DATABASE_URL=postgresql+asyncpg://user:pass@rds-host.region.rds.amazonaws.com:5432/nucleus
# DATABASE_URL_SYNC=postgresql+psycopg2://user:pass@rds-host.region.rds.amazonaws.com:5432/nucleus

# ---- Qdrant (Vector DB) -----------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=CHANGE_ME_if_using_qdrant_cloud
QDRANT_COLLECTION=nucleus_context

# ---- OpenAI / LLM ------------------------------------------------------------
OPENAI_API_KEY=sk-CHANGE_ME
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ---- NextAuth ----------------------------------------------------------------
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# ---- Frontend Database (Prisma) ----------------------------------------------
DATABASE_URL=postgresql://nucleus:CHANGE_ME@postgres:5432/nucleus

# ---- CORS --------------------------------------------------------------------
CORS_ORIGINS=["https://yourdomain.com"]

# ---- Rate Limiting -----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# ---- Logging -----------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Sentry (Error Tracking) ------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- AWS (optional, for S3 file uploads) ------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# ---- Email (optional, for notifications) ------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
