# =============================================================================
# Nucleus AI Frontend — Production Environment Variables
# =============================================================================

# Public (baked into client bundle at build time)
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Server-side only
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# Prisma database URL
DATABASE_URL=postgresql://nucleus:CHANGE_ME@postgres:5432/nucleus

# Optional: Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
