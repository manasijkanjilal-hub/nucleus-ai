// =============================================================================
// Nucleus AI — Prisma Schema
// Phase 1: RBAC, enhanced models, Context Vault, audit logging, notifications
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum DocumentType {
  PDF
  DOCX
  TXT
  WEB
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  WELCOME
  PASSWORD_RESET
  GENERATION_COMPLETE
  LIMIT_WARNING
  CAMPAIGN_STATUS
  SYSTEM_ANNOUNCEMENT
  INFO
  SUCCESS
  WARNING
  ERROR
}

// -----------------------------------------------------------------------------
// User
// -----------------------------------------------------------------------------

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  password String
  image    String?

  // RBAC & account state
  role   Role       @default(VIEWER)
  status UserStatus @default(ACTIVE)

  // Email verification
  emailVerified          Boolean @default(false)
  emailVerificationToken String? @unique

  // Password reset
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  // Security / login tracking
  lastLogin     DateTime?
  loginAttempts Int       @default(0)
  lockedUntil   DateTime?

  // Session invalidation ("logout from all devices" increments this).
  // Tokens carrying an older version are rejected by the JWT callback.
  sessionVersion Int @default(0)

  // Notification preferences (in-app is always on; this gates email delivery).
  emailNotifications Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  brandProfiles    BrandProfile[]     @relation("BrandOwner")
  createdBrands    BrandProfile[]     @relation("BrandCreator")
  documents        UploadedDocument[]
  contextDocuments Document[]         @relation("DocumentUploader")
  campaigns        Campaign[]         @relation("CampaignCreator")
  auditLogs        AuditLog[]
  notifications    Notification[]
  aiGenerations    AIGeneration[]
  subscription     Subscription?
  invoices         Invoice[]

  @@index([role])
  @@index([status])
}

// -----------------------------------------------------------------------------
// BrandProfile
// -----------------------------------------------------------------------------

model BrandProfile {
  id             String  @id @default(cuid())
  name           String
  industry       String?
  targetAudience String?
  brandVoice     String?
  description    String?
  logoUrl        String?

  // Enhanced fields
  logo        String?
  website     String?
  brandColors Json?
  guidelines  String?

  // Ownership
  userId    String
  user      User    @relation("BrandOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdBy String?
  creator   User?   @relation("BrandCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  campaigns     Campaign[]
  documents     Document[]
  aiGenerations AIGeneration[]

  @@index([userId])
  @@index([createdBy])
}

// -----------------------------------------------------------------------------
// Campaign
// -----------------------------------------------------------------------------

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?
  type        String?
  goals       String?
  status      CampaignStatus @default(DRAFT)

  // Ownership / relations
  brandId   String
  brand     BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy String?
  creator   User?        @relation("CampaignCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  aiGenerations AIGeneration[]

  @@index([brandId])
  @@index([createdBy])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Document (Context Vault)
// -----------------------------------------------------------------------------

model Document {
  id       String       @id @default(cuid())
  name     String // original (sanitized) display name
  fileName String? // stored file name on disk (UUID-based)
  type     DocumentType

  filePath String?
  fileSize Int?
  mimeType String?

  // Ownership / relations
  brandId    String?
  brand      BrandProfile? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  uploadedBy String
  uploader   User          @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  // Processing & embeddings
  processingStatus ProcessingStatus @default(PENDING)
  embeddingStatus  ProcessingStatus @default(PENDING)
  errorMessage     String?
  chunkCount       Int              @default(0)
  wordCount        Int              @default(0)
  vectorId         String? // legacy single-id field (retained)
  vectorIds        Json? // array of vector point ids in Qdrant

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([uploadedBy])
  @@index([processingStatus])
}

// -----------------------------------------------------------------------------
// UploadedDocument (legacy direct-upload flow — retained for compatibility)
// -----------------------------------------------------------------------------

model UploadedDocument {
  id               String   @id @default(cuid())
  fileName         String
  fileType         String
  cloudStoragePath String?
  isPublic         Boolean  @default(false)
  brandId          String?
  status           String   @default("uploaded")
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([brandId])
}

// -----------------------------------------------------------------------------
// AuditLog
// -----------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Notification
// -----------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(INFO)
  title     String
  message   String           @db.Text
  read      Boolean          @default(false)
  metadata  Json?            // extra structured data (e.g. links, ids)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId])
  @@index([read])
}

// -----------------------------------------------------------------------------
// AIGeneration (AI content generation history)
// -----------------------------------------------------------------------------

model AIGeneration {
  id               String  @id @default(uuid())
  contentType      String
  prompt           String  @db.Text
  generatedContent String  @db.Text
  provider         String  @default("openai")
  model            String  @default("gpt-4o-mini")
  tokensUsed       Int     @default(0)
  cost             Decimal @default(0)

  // Relations
  brandId String
  brand   BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([brandId])
  @@index([userId])
  @@index([campaignId])
  @@index([contentType])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Billing & Subscriptions (Phase 3A)
// -----------------------------------------------------------------------------

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

model Subscription {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan   @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  // Stripe fields
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  // Billing cycle
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  // Usage tracking
  generationsUsed  Int @default(0)
  generationsLimit Int @default(10)
  brandsUsed       Int @default(0)
  brandsLimit      Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model Invoice {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  stripeInvoiceId String    @unique
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("usd")
  status          String
  paidAt          DateTime?
  invoiceUrl      String?

  createdAt DateTime @default(now())

  @@index([userId])
}


// -----------------------------------------------------------------------------
// AI Provider configuration (Phase 3C — Multi-AI Provider Support)
// -----------------------------------------------------------------------------
// Admin-managed per-provider state. API keys may also come from environment
// variables; a value stored here overrides the env var. Secret values are
// never returned by the API (only a "configured" boolean is exposed).
model ProviderSetting {
  id        String   @id @default(uuid())
  provider  String   @unique // 'openai' | 'gemini' | 'claude'
  apiKey    String?  @db.Text // optional override; env var used when null
  enabled   Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// SystemSettings (Phase 3E — Admin Power Features)
// -----------------------------------------------------------------------------
// Single-row table holding platform-wide configuration. We always read/write
// the row with id = "singleton" (upserted on demand). `featureFlags` is a JSON
// object of boolean toggles, e.g. { enableRegistration: true, ... }.
model SystemSettings {
  id              String   @id @default("singleton")
  platformName    String   @default("Nucleus AI")
  supportEmail    String   @default("support@nucleus-ai.com")
  maintenanceMode Boolean  @default(false)
  featureFlags    Json     @default("{}")
  updatedAt       DateTime @updatedAt
  updatedBy       String?
}
