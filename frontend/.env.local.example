# =============================================================================
# Nucleus AI — Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
#
# Next.js loads .env.local automatically (it is gitignored by default).
# See ENV_SETUP.md in the project root for detailed instructions.
# =============================================================================

# ---- NextAuth.js (Authentication) --------------------------------------------
# Secret used to sign/encrypt session JWTs
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# Canonical URL of your app (must match the URL users visit)
# Local development:
NEXTAUTH_URL=http://localhost:3000
# Production example:
# NEXTAUTH_URL=https://yourdomain.com

# ---- Database (Prisma ORM) ---------------------------------------------------
# Standard PostgreSQL connection string (used by Prisma Client & migrations)
# Local:
DATABASE_URL=postgresql://nucleus:nucleus@localhost:5432/nucleus
#
# Managed DB (Supabase / Neon / RDS):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ---- Backend API URL ---------------------------------------------------------
# Points the frontend to the FastAPI backend
# NEXT_PUBLIC_ prefix exposes the variable to browser-side code
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ---- AWS S3 (File Uploads — optional) ----------------------------------------
# Only needed if you use the document upload / brand asset features
# Get credentials at: https://console.aws.amazon.com/iam/
AWS_PROFILE=default
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name
AWS_FOLDER_PREFIX=nucleus-ai/uploads

# AWS credentials (set these OR use AWS_PROFILE with ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Abacus AI (optional) ----------------------------------------------------
# Only needed if you use Abacus AI platform features
# ABACUSAI_API_KEY=your-abacus-ai-api-key

# ---- AI Providers (Content Generation) ---------------------------------------
# Multi-provider support: OpenAI, Google Gemini & Anthropic Claude. Keys can
# also be set/overridden per-provider in the admin panel (/admin/ai-providers).
# Any provider with a key becomes selectable in the campaign generator; if none
# are configured, generation falls back to deterministic mock content.
#
# OpenAI (also used for Context Vault embeddings below).
# OPENAI_API_KEY=            # set once below — used for both generation & embeddings
# Google Gemini — https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=
# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Context Vault (document processing, embeddings & vector search) ---
# OpenAI embeddings. If unset, a deterministic local fallback is used so the
# pipeline still works in development (search quality is reduced).
# NOTE: OPENAI_API_KEY is shared — it powers both AI content generation
# (above) and the Context Vault embeddings here.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSION=1536
# Qdrant vector database. If unreachable, an in-memory/file fallback is used.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nucleus_context
QDRANT_API_KEY=
# Where uploaded documents are stored on disk (swap for S3 in production).
DOCUMENT_STORAGE_DIR=./.uploads



# ---- Stripe (Billing & Subscriptions) ----------------------------------------
# Billing is OPTIONAL: if these are unset, the app still runs and shows the
# Free plan. Subscription/checkout actions return a clear "not configured"
# message until keys are added.
#
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Exposed to the browser (Stripe.js). Usually same value as PUBLISHABLE_KEY.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret from `stripe listen` or the Dashboard webhook config.
# Endpoint to register: https://your-domain.com/api/billing/webhook
STRIPE_WEBHOOK_SECRET=

# Recurring price IDs for each paid plan (create products/prices in Stripe).
# These map to the STARTER ($29/mo) and PRO ($99/mo) plans in src/lib/plans.ts.
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
