# =============================================================================
# Nucleus AI — Production Backend Dockerfile (multi-stage)
# =============================================================================
# Stage 1: Builder — install deps in a venv so we can copy a clean tree
# Stage 2: Runtime — slim image with only what's needed
# =============================================================================

# ---- Stage 1: Builder -------------------------------------------------------
FROM python:3.12-slim AS builder

WORKDIR /build

# System deps needed to compile psycopg2, asyncpg, etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev gcc && \
    rm -rf /var/lib/apt/lists/*

# Create virtualenv so the runtime stage stays clean
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir gunicorn

# ---- Stage 2: Runtime --------------------------------------------------------
FROM python:3.12-slim AS runtime

LABEL maintainer="Nucleus AI Team"
LABEL description="Nucleus AI Backend — FastAPI production image"

# Runtime-only system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl tini && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd -r nucleus && useradd -r -g nucleus -d /app -s /sbin/nologin nucleus

# Copy virtualenv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    APP_ENV=production

WORKDIR /app
COPY backend/ .

# Remove dev artefacts
RUN rm -rf tests/ __pycache__ .pytest_cache .env

# Own everything as non-root user
RUN chown -R nucleus:nucleus /app
USER nucleus

EXPOSE 8000

# Health-check — hits FastAPI /health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Use tini as PID 1 for proper signal handling
ENTRYPOINT ["tini", "--"]

# Gunicorn with Uvicorn workers for production
CMD ["gunicorn", "main:app", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--workers", "4", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "120", \
     "--keep-alive", "5", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--log-level", "info"]
