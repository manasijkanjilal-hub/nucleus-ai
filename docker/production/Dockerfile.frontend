# =============================================================================
# Nucleus AI — Production Frontend Dockerfile (multi-stage)
# =============================================================================
# Stage 1: Dependencies
# Stage 2: Builder — next build
# Stage 3: Runner — standalone Next.js server
# =============================================================================

# ---- Stage 1: Install dependencies ------------------------------------------
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --only=production && \
    cp -R node_modules /prod_modules && \
    npm ci

# ---- Stage 2: Build ----------------------------------------------------------
FROM node:20-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ .

# Build-time env vars (non-secret, baked into client bundle)
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:8000} \
    NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL:-http://localhost:3000}

# Generate Prisma client if schema exists
RUN if [ -f prisma/schema.prisma ]; then npx prisma generate; fi

# Enable Next.js standalone output
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ---- Stage 3: Production runner ----------------------------------------------
FROM node:20-alpine AS runner

LABEL maintainer="Nucleus AI Team"
LABEL description="Nucleus AI Frontend — Next.js production image"

RUN apk add --no-cache curl tini && \
    addgroup --system --gid 1001 nucleus && \
    adduser --system --uid 1001 nucleus

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Copy build output — standalone mode or full build
COPY --from=builder --chown=nucleus:nucleus /app/.next ./.next
COPY --from=builder --chown=nucleus:nucleus /app/public ./public
COPY --from=builder --chown=nucleus:nucleus /app/package.json ./package.json
COPY --from=deps --chown=nucleus:nucleus /prod_modules ./node_modules

# Copy Prisma if present
COPY --from=builder --chown=nucleus:nucleus /app/prisma ./prisma 2>/dev/null || true

USER nucleus

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

ENTRYPOINT ["tini", "--"]
CMD ["npm", "start"]
